
<!-- Home/main content -->
<main id="main-content">
  <div id="page-home">
    <section class="relative bg-gradient-to-br from-brand-cream via-brand-sand to-brand-cream overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-20 left-10 w-72 h-72 bg-brand-copper rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 right-10 w-96 h-96 bg-brand-sage rounded-full blur-3xl"></div>
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="animate-fade-in-up">
            <span class="inline-block px-4 py-1.5 bg-brand-copper/10 text-brand-copper text-sm font-semibold rounded-full mb-6">New Collection 2024</span>
            <h2 id="hero-title" class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-brand-charcoal leading-tight mb-6">Elevate Your<br><span class="text-brand-copper">Culinary Space</span></h2>
            <p id="hero-subtitle" class="text-lg text-gray-600 mb-8 max-w-lg">Discover premium kitchen essentials crafted for the modern UAE home. From artisan cookware to elegant dining sets.</p>
            <div class="flex flex-wrap gap-4">
              <button onclick="navigateTo && navigateTo('shop')" class="px-8 py-4 bg-brand-charcoal text-white font-semibold rounded-lg hover:bg-brand-copper transition-all duration-300 transform hover:scale-105 shadow-lg"> Shop Now </button>
              <button onclick="filterByCategory && filterByCategory('new')" class="px-8 py-4 bg-white text-brand-charcoal font-semibold rounded-lg border-2 border-brand-charcoal hover:bg-brand-charcoal hover:text-white transition-all duration-300"> New Arrivals </button>
            </div>
            <div class="flex items-center gap-8 mt-10">
              <div><p class="text-3xl font-bold text-brand-charcoal">500+</p><p class="text-sm text-gray-500">Products</p></div>
              <div class="w-px h-12 bg-brand-sand"></div>
              <div><p class="text-3xl font-bold text-brand-charcoal">50K+</p><p class="text-sm text-gray-500">Happy Customers</p></div>
              <div class="w-px h-12 bg-brand-sand"></div>
              <div><p class="text-3xl font-bold text-brand-charcoal">4.9</p><p class="text-sm text-gray-500">Rating</p></div>
            </div>
          </div>

          <div class="relative animate-fade-in-up stagger-2">
            <div class="relative bg-white rounded-3xl shadow-2xl p-8 transform rotate-3 hover:rotate-0 transition-transform duration-500">
              <svg viewBox="0 0 400 300" class="w-full"><rect x="50" y="100" width="300" height="150" rx="8" fill="#E8E0D5" /> <rect x="70" y="120" width="80" height="60" rx="4" fill="#B87333" /> <rect x="80" y="130" width="60" height="40" rx="2" fill="#2D2D2D" opacity="0.8" /> <circle cx="110" cy="150" r="10" fill="#F8F5F0" /></svg>
            </div>
            <div class="absolute -bottom-4 -left-4 bg-brand-copper text-white px-6 py-3 rounded-lg shadow-lg">
              <p class="text-sm font-bold">Up to 40% OFF</p>
              <p class="text-xs opacity-80">This Weekend</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h3 class="text-3xl font-display font-bold text-brand-charcoal mb-4">Shop by Category</h3>
          <p class="text-gray-600">Find exactly what you need for your kitchen</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div onclick="filterByCategory && filterByCategory('appliances')" class="group cursor-pointer">
            <div class="bg-gradient-to-br from-brand-sand to-brand-cream rounded-2xl p-8 text-center transform transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl">
              <div class="w-20 h-20 mx-auto mb-4 bg-brand-copper/10 rounded-full flex items-center justify-center group-hover:bg-brand-copper/20 transition-colors">
                <svg viewBox="0 0 48 48" class="w-10 h-10"><rect x="12" y="8" width="24" height="32" rx="3" fill="#B87333" /></svg>
              </div>
              <h4 class="font-semibold text-brand-charcoal mb-1">Appliances</h4>
              <p class="text-sm text-gray-500">45 Products</p>
            </div>
          </div>

          <div onclick="filterByCategory && filterByCategory('accessories')" class="group cursor-pointer">
            <div class="bg-gradient-to-br from-brand-sand to-brand-cream rounded-2xl p-8 text-center transform transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl">
              <div class="w-20 h-20 mx-auto mb-4 bg-brand-sage/10 rounded-full flex items-center justify-center group-hover:bg-brand-sage/20 transition-colors">
                <svg viewBox="0 0 48 48" class="w-10 h-10"><path d="M24 8 L24 20" stroke="#8B9A7D" stroke-width="3" stroke-linecap="round" /></svg>
              </div>
              <h4 class="font-semibold text-brand-charcoal mb-1">Accessories</h4>
              <p class="text-sm text-gray-500">68 Products</p>
            </div>
          </div>

          <div onclick="filterByCategory && filterByCategory('dining')" class="group cursor-pointer">
            <div class="bg-gradient-to-br from-brand-sand to-brand-cream rounded-2xl p-8 text-center transform transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl">
              <div class="w-20 h-20 mx-auto mb-4 bg-brand-copper/10 rounded-full flex items-center justify-center group-hover:bg-brand-copper/20 transition-colors">
                <svg viewBox="0 0 48 48" class="w-10 h-10"><ellipse cx="24" cy="30" rx="16" ry="8" fill="#B87333" /></svg>
              </div>
              <h4 class="font-semibold text-brand-charcoal mb-1">Dining &amp; Bar</h4>
              <p class="text-sm text-gray-500">52 Products</p>
            </div>
          </div>

          <div onclick="filterByCategory && filterByCategory('cookware')" class="group cursor-pointer">
            <div class="bg-gradient-to-br from-brand-sand to-brand-cream rounded-2xl p-8 text-center transform transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl">
              <div class="w-20 h-20 mx-auto mb-4 bg-brand-charcoal/10 rounded-full flex items-center justify-center group-hover:bg-brand-charcoal/20 transition-colors">
                <svg viewBox="0 0 48 48" class="w-10 h-10"><ellipse cx="24" cy="32" rx="14" ry="6" fill="#2D2D2D" /></svg>
              </div>
              <h4 class="font-semibold text-brand-charcoal mb-1">Cookware</h4>
              <p class="text-sm text-gray-500">38 Products</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-brand-cream">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-12">
          <div>
            <h3 class="text-3xl font-display font-bold text-brand-charcoal mb-2">Featured Products</h3>
            <p class="text-gray-600">Handpicked favorites for your kitchen</p>
          </div>
          <button onclick="navigateTo && navigateTo('shop')" class="hidden sm:flex items-center gap-2 text-brand-copper font-semibold hover:gap-3 transition-all"> View All <i data-lucide="arrow-right" class="w-5 h-5"></i> </button>
        </div>
        <div id="featured-products" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"></div>
      </div>
    </section>
  </div>

  <div id="page-shop" class="hidden py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
          <h2 class="text-3xl font-display font-bold text-brand-charcoal" id="shop-title">All Products</h2>
          <p class="text-gray-600" id="product-count">Showing all products</p>
        </div>
        <div class="flex items-center gap-4">
          <select id="sort-select" onchange="sortProducts && sortProducts(this.value)" class="px-4 py-2 bg-white border border-brand-sand rounded-lg focus:outline-none focus:border-brand-copper">
            <option value="featured">Featured</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="newest">Newest First</option>
          </select>
        </div>
      </div>

      <div class="flex flex-wrap gap-2 mb-8">
        <button onclick="filterByCategory && filterByCategory('all')" class="category-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-brand-charcoal text-white" data-category="all">All</button>
        <button onclick="filterByCategory && filterByCategory('appliances')" class="category-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-white text-brand-charcoal border border-brand-sand hover:border-brand-copper" data-category="appliances">Appliances</button>
        <button onclick="filterByCategory && filterByCategory('accessories')" class="category-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-white text-brand-charcoal border border-brand-sand hover:border-brand-copper" data-category="accessories">Accessories</button>
        <button onclick="filterByCategory && filterByCategory('dining')" class="category-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-white text-brand-charcoal border border-brand-sand hover:border-brand-copper" data-category="dining">Dining &amp; Bar</button>
        <button onclick="filterByCategory && filterByCategory('cookware')" class="category-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-white text-brand-charcoal border border-brand-sand hover:border-brand-copper" data-category="cookware">Cookware</button>
        <button onclick="filterByCategory && filterByCategory('new')" class="category-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-white text-brand-charcoal border border-brand-sand hover:border-brand-copper" data-category="new">New Arrivals</button>
      </div>

      <div id="shop-products" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"></div>
    </div>
  </div>

  <div id="page-product" class="hidden py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <button onclick="navigateTo && navigateTo('shop')" class="flex items-center gap-2 text-gray-600 hover:text-brand-copper mb-8 transition-colors"> <i data-lucide="arrow-left" class="w-5 h-5"></i> Back to Shop </button>
      <div id="product-detail-content"></div>
    </div>
  </div>

  <div id="page-cart" class="hidden py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-display font-bold text-brand-charcoal mb-8">Shopping Cart</h2>
      <div id="cart-content"></div>
    </div>
  </div>

  <div id="page-wishlist" class="hidden py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-display font-bold text-brand-charcoal mb-8">My Wishlist</h2>
      <div id="wishlist-content"></div>
    </div>
  </div>

  <div id="page-about" class="hidden py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-display font-bold text-brand-charcoal mb-4">About UrbanNest</h2>
        <p class="text-xl text-gray-600">Your premier destination for kitchen excellence in the UAE</p>
      </div>
      <div class="prose prose-lg max-w-none">
        <div class="bg-white rounded-2xl p-8 shadow-sm mb-8">
          <h3 class="text-2xl font-display font-bold text-brand-charcoal mb-4">Our Story</h3>
          <p class="text-gray-600 mb-4">Founded in Dubai in 2020, UrbanNest was born from a passion for bringing world-class kitchen products to the UAE market.</p>
        </div>
      </div>
    </div>
  </div>
</main>
