<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ shop.name | default: 'UrbanNest' }}</title>

  <!-- Fonts & CDNs -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>

  <!-- Theme CSS -->
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}" />

  {{ content_for_header }}
</head>
<body class="h-full bg-brand-cream font-body text-brand-charcoal">
  {% section 'header' %}
  {{ content_for_layout }}
  {% section 'footer' %}
  <script src="{{ 'theme.js' | asset_url }}"></script>
  {{ content_for_footer }}
</body>
</html>
